# Copy to .env (git-ignored). All keys are optional.
# Stock fetching is CC0/public-domain by default; NASA, Wikimedia and Internet Archive need no key.

# Openverse works anonymously; a key only raises rate limits.
OPENVERSE_API_KEY=
# Smithsonian Open Access (CC0): free key at api.data.gov (a shared DEMO_KEY is rate-limited).
SMITHSONIAN_API_KEY=
# Pexels / Pixabay (photos + videos): platform licenses, NOT CC0. Used only when a key is set
# and stock_media.strict_cc0_only is false. Free keys: pexels.com/api, pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Local LLM overrides (OpenAI-compatible endpoint, e.g. Ollama)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b-instruct
# LLM_NATIVE_API=http://localhost:11434
# VIDEOMAKER_OFFLINE=1
